{
  "db_name": "PostgreSQL",
  "query": "\n        UPDATE jobs SET locked_at = now(), attempts = attempts + 1\n        WHERE id = (\n            SELECT id FROM jobs\n            WHERE queue = $1\n              AND run_at <= now()\n              AND (locked_at IS NULL OR locked_at < now() - make_interval(mins => $2))\n            ORDER BY id\n            FOR UPDATE SKIP LOCKED\n            LIMIT 1\n        )\n        RETURNING id, payload, attempts\n        ",
