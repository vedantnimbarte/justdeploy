  "query": "SELECT l.id, l.ts, l.line, l.level, l.trace_id, l.fields,\n                  l.service_id AS \"service_id!\", sv.name AS service\n           FROM log_lines l JOIN services sv ON sv.id = l.service_id\n           WHERE l.trace_id = $1\n           ORDER BY l.ts, l.id LIMIT 500",
