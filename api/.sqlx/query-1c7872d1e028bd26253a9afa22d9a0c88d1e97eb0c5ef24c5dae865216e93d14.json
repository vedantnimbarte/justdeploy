  "query": "SELECT id, ts, line FROM log_lines\n           WHERE service_id = $1 AND ts > now() - make_interval(hours => $2)\n             AND line ILIKE $3 AND ($4::bigint IS NULL OR id < $4)\n           ORDER BY id DESC LIMIT 200",
